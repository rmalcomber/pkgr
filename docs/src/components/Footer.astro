---
// Starlight's default footer plus the shared "Support the project" line on every page.
import Default from '@astrojs/starlight/components/Footer.astro'
import { site } from '../site.config.mjs'
---

<Default {...Astro.props}><slot /></Default>
<p class="support" data-pagefind-ignore>
  Support the project:{' '}
  <a href={site.support.coffee} rel="noopener">Buy Me a Coffee</a>{' '}or{' '}
  <a href={site.support.sponsors} rel="noopener">GitHub Sponsors</a>.
</p>

<style>
  .support {
    margin-top: 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
